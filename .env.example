# Environment Variables Template for Sierra Class Helper
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# API Configuration
# For local development this defaults to http://localhost:8000.
# REQUIRED when ENVIRONMENT=production — the bot will refuse to start otherwise.
# On Railway this is set automatically to the api service's private domain.
API_URL=http://localhost:8000

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Persistent data directory. Leave unset locally (defaults to '.') so data
# files land at the repo root. Set to /data in Railway after attaching a
# Volume to the api service at that mount point.
# SIERRA_DATA_DIR=/data

# Set to 1 only on the api service in production to enable the in-process
# refresh scheduler (hourly course scrape + daily ratings refresh). Leave
# unset locally and in tests.
# SIERRA_ENABLE_SCHEDULER=1

# Shared secret for the /admin/stats endpoint. Generate any random string
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
SIERRA_ADMIN_TOKEN=replace-me-with-a-random-token

# Notes:
# - Get OpenAI API key from: https://platform.openai.com/api-keys
# - Get Discord bot token from: https://discord.com/developers/applications
# - Never commit your actual .env file to git
# - On Railway, set these as environment variables in the dashboard
