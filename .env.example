# Environment Variables Template for Sierra Class Helper
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# API Configuration
# For local development this defaults to http://localhost:8000.
# REQUIRED when ENVIRONMENT=production — the bot will refuse to start otherwise.
# On Railway this is set automatically to the api service's private domain.
API_URL=http://localhost:8000

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Notes:
# - Get OpenAI API key from: https://platform.openai.com/api-keys
# - Get Discord bot token from: https://discord.com/developers/applications
# - Never commit your actual .env file to git
# - On Railway, set these as environment variables in the dashboard
